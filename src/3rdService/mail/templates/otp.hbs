<!DOCTYPE html>
<html>

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mã Xác Thực PhotoGo</title>
</head>

<body style="margin: 0; padding: 0; font-family: Arial, sans-serif; background-color: #f7f7f7; color: #333333;">
  <table width="100%" cellspacing="0" cellpadding="0" border="0"
    style="max-width: 600px; margin: 0 auto; background-color: #ffffff;">

    <!-- Main Content -->
    <tr>
      <td align="center" style="padding: 30px 20px;">
        <h1 style="margin: 0 0 20px 0; font-size: 24px; color: #FF6B00;">{{content}}</h1>
        <p style="margin: 0 0 25px 0; font-size: 16px; color: #666666;">{{body}}</p>

        <!-- Simple Film Strip OTP Code -->
        <table width="100%" cellspacing="0" cellpadding="0" border="0"
          style="max-width: 400px; margin: 0 auto 30px auto; border-collapse: collapse;">
          <!-- Film strip top border -->
          <tr>
            <td style="background-color: #222222; height: 15px; padding: 0;">
              <table width="100%" cellspacing="0" cellpadding="0" border="0">
                <tr>
                  <td width="10%" align="center" style="padding: 0;">
                    <div
                      style="width: 10px; height: 10px; background-color: #f7f7f7; border-radius: 50%; margin: 0 auto;">
                    </div>
                  </td>
                  <td width="10%" align="center" style="padding: 0;">
                    <div
                      style="width: 10px; height: 10px; background-color: #f7f7f7; border-radius: 50%; margin: 0 auto;">
                    </div>
                  </td>
                  <td width="10%" align="center" style="padding: 0;">
                    <div
                      style="width: 10px; height: 10px; background-color: #f7f7f7; border-radius: 50%; margin: 0 auto;">
                    </div>
                  </td>
                  <td width="10%" align="center" style="padding: 0;">
                    <div
                      style="width: 10px; height: 10px; background-color: #f7f7f7; border-radius: 50%; margin: 0 auto;">
                    </div>
                  </td>
                  <td width="10%" align="center" style="padding: 0;">
                    <div
                      style="width: 10px; height: 10px; background-color: #f7f7f7; border-radius: 50%; margin: 0 auto;">
                    </div>
                  </td>
                  <td width="10%" align="center" style="padding: 0;">
                    <div
                      style="width: 10px; height: 10px; background-color: #f7f7f7; border-radius: 50%; margin: 0 auto;">
                    </div>
                  </td>
                  <td width="10%" align="center" style="padding: 0;">
                    <div
                      style="width: 10px; height: 10px; background-color: #f7f7f7; border-radius: 50%; margin: 0 auto;">
                    </div>
                  </td>
                  <td width="10%" align="center" style="padding: 0;">
                    <div
                      style="width: 10px; height: 10px; background-color: #f7f7f7; border-radius: 50%; margin: 0 auto;">
                    </div>
                  </td>
                  <td width="10%" align="center" style="padding: 0;">
                    <div
                      style="width: 10px; height: 10px; background-color: #f7f7f7; border-radius: 50%; margin: 0 auto;">
                    </div>
                  </td>
                  <td width="10%" align="center" style="padding: 0;">
                    <div
                      style="width: 10px; height: 10px; background-color: #f7f7f7; border-radius: 50%; margin: 0 auto;">
                    </div>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          
        <p style="margin: 0 0 25px 0; font-size: 14px; color: #888888;">Nếu bạn không yêu cầu mã này, bạn có thể bỏ qua
          email này.</p>

        <!-- CTA Button -->
        <table cellspacing="0" cellpadding="0" border="0" align="center">
          <tr>
            <td align="center" style="background-color: #FF6B00; border-radius: 4px;">
              <a href="{{link}}" target="_blank"
                style="display: inline-block; padding: 14px 30px; font-size: 16px; color: #ffffff; text-decoration: none; font-weight: bold;">Xác
                Thực Ngay</a>
            </td>
          </tr>
        </table>
      </td>
    </tr>

</body>

</html>