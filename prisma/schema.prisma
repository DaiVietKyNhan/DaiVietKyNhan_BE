generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                            Int                                   @id @default(autoincrement())
  email                         String                                @unique @db.VarChar(500)
  name                          String                                @db.VarChar(500)
  password                      String                                @db.VarChar(500)
  phoneNumber                   String?                               @db.VarChar(50)
  avatar                        String?                               @db.VarChar(1000)
  status                        UserStatus                            @default(INACTIVE)
  roleId                        Int
  createdById                   Int?
  updatedById                   Int?
  deletedById                   Int?
  deletedAt                     DateTime?
  createdAt                     DateTime                              @default(now())
  updatedAt                     DateTime                              @updatedAt
  birthDate                     DateTime?
  gender                        Gender?
  coin                          Int                                   @default(0)
  point                         Int                                   @default(0)
  pointTestHome                 Boolean                               @default(false)
  figureId                      Int?
  godProfileId                  Int?
  heart                         Int                                   @default(3)
  createdAchievements           Achievement[]                         @relation("AchievementCreatedBy")
  deletedAchievements           Achievement[]                         @relation("AchievementDeletedBy")
  updatedAchievements           Achievement[]                         @relation("AchievementUpdatedBy")
  createdValidTextInputs        Answer[]                              @relation("ValidTextInputAnswerCreatedBy")
  deletedValidTextInputs        Answer[]                              @relation("ValidTextInputAnswerDeletedBy")
  updatedValidTextInputs        Answer[]                              @relation("ValidTextInputAnswerUpdatedBy")
  createdAttendances            Attendance[]                          @relation("AttendanceCreatedBy")
  deletedAttendances            Attendance[]                          @relation("AttendanceDeletedBy")
  updatedAttendances            Attendance[]                          @relation("AttendanceUpdatedBy")
  attendances                   Attendance[]
  createdAttendanceConfigs      AttendanceConfig[]                    @relation("AttendanceConfigCreatedBy")
  deletedAttendanceConfigs      AttendanceConfig[]                    @relation("AttendanceConfigDeletedBy")
  updatedAttendanceConfigs      AttendanceConfig[]                    @relation("AttendanceConfigUpdatedBy")
  createdChiTiets               ChiTietKyNhan[]                       @relation("ChiTietKyNhanCreatedBy")
  deletedChiTiets               ChiTietKyNhan[]                       @relation("ChiTietKyNhanDeletedBy")
  updatedChiTiets               ChiTietKyNhan[]                       @relation("ChiTietKyNhanUpdatedBy")
  createdBoiCanhLichSuVaSuuThan ChiTietKyNhanBoiCanhLichSuVaSuuThan[] @relation("ChiTietKyNhanBoiCanhLichSuVaSuuThanCreatedBy")
  deletedBoiCanhLichSuVaSuuThan ChiTietKyNhanBoiCanhLichSuVaSuuThan[] @relation("ChiTietKyNhanBoiCanhLichSuVaSuuThanDeletedBy")
  updatedBoiCanhLichSuVaSuuThan ChiTietKyNhanBoiCanhLichSuVaSuuThan[] @relation("ChiTietKyNhanBoiCanhLichSuVaSuuThanUpdatedBy")
  createdGiaiThoaiDanGian       ChiTietKyNhanGiaiThoaiDanGian[]       @relation("ChiTietKyNhanGiaiThoaiDanGianCreatedBy")
  deletedGiaiThoaiDanGian       ChiTietKyNhanGiaiThoaiDanGian[]       @relation("ChiTietKyNhanGiaiThoaiDanGianDeletedBy")
  updatedGiaiThoaiDanGian       ChiTietKyNhanGiaiThoaiDanGian[]       @relation("ChiTietKyNhanGiaiThoaiDanGianUpdatedBy")
  createdSuSachVietGi           ChiTietKyNhanSuSachVietGi[]           @relation("ChiTietKyNhanSuSachVietGiCreatedBy")
  deletedSuSachVietGi           ChiTietKyNhanSuSachVietGi[]           @relation("ChiTietKyNhanSuSachVietGiDeletedBy")
  updatedSuSachVietGi           ChiTietKyNhanSuSachVietGi[]           @relation("ChiTietKyNhanSuSachVietGiUpdatedBy")
  devices                       Device[]
  createdFigures                Figure[]                              @relation("FigureCreatedBy")
  deletedFigures                Figure[]                              @relation("FigureDeletedBy")
  updatedFigures                Figure[]                              @relation("FigureUpdatedBy")
  createdGodProfiles            GodProfile[]                          @relation("GodProfileCreatedBy")
  deletedGodProfiles            GodProfile[]                          @relation("GodProfileDeletedBy")
  updatedGodProfiles            GodProfile[]                          @relation("GodProfileUpdatedBy")
  createdKyNhans                KyNhan[]                              @relation("KyNhanCreatedBy")
  deletedKyNhans                KyNhan[]                              @relation("KyNhanDeletedBy")
  updatedKyNhans                KyNhan[]                              @relation("KyNhanUpdatedBy")
  createdKyNhanSummaries        KyNhanSummary[]                       @relation("KyNhanSummaryCreatedBy")
  deletedKyNhanSummaries        KyNhanSummary[]                       @relation("KyNhanSummaryDeletedBy")
  updatedKyNhanSummaries        KyNhanSummary[]                       @relation("KyNhanSummaryUpdatedBy")
  createdLands                  Land[]                                @relation("LandCreatedBy")
  deletedLands                  Land[]                                @relation("LandDeletedBy")
  updatedLands                  Land[]                                @relation("LandUpdatedBy")
  createdLandBarges             LandBarge[]                           @relation("LandBargeCreatedBy")
  deletedLandBarges             LandBarge[]                           @relation("LandBargeDeletedBy")
  updatedLandBarges             LandBarge[]                           @relation("LandBargeUpdatedBy")
  createdMedias                 Media[]                               @relation("MediaCreatedBy")
  deletedMedias                 Media[]                               @relation("MediaDeletedBy")
  updatedMedias                 Media[]                               @relation("MediaUpdatedBy")
  createdMotaKyNhans            MotaKyNhan[]                          @relation("MoTaKyNhanCreatedBy")
  deletedMotaKyNhans            MotaKyNhan[]                          @relation("MoTaKyNhanDeletedBy")
  updatedMotaKyNhans            MotaKyNhan[]                          @relation("MoTaKyNhanUpdatedBy")
  createdPermissions            Permission[]                          @relation("PermissionCreatedBy")
  deletedPermissions            Permission[]                          @relation("PermissionDeletedBy")
  updatedPermissions            Permission[]                          @relation("PermissionUpdatedBy")
  createdQuestions              Question[]                            @relation("QuestionCreatedBy")
  deletedQuestions              Question[]                            @relation("QuestionDeletedBy")
  updatedQuestions              Question[]                            @relation("QuestionUpdatedBy")
  refreshTokens                 RefreshToken[]
  createdRewards                Reward[]                              @relation("RewardCreatedBy")
  deletedRewards                Reward[]                              @relation("RewardDeletedBy")
  updatedRewards                Reward[]                              @relation("RewardUpdatedBy")
  createdRoles                  Role[]                                @relation("RoleCreatedBy")
  deletedRoles                  Role[]                                @relation("RoleDeletedBy")
  updatedRoles                  Role[]                                @relation("RoleUpdatedBy")
  createdSystemConfigs          SystemConfig[]                        @relation("SystemConfigCreatedBy")
  deletedSystemConfigs          SystemConfig[]                        @relation("SystemConfigDeletedBy")
  updatedSystemConfigs          SystemConfig[]                        @relation("SystemConfigUpdatedBy")
  createdTestQuestionHomes      TestQuestionHome[]                    @relation("TestQuestionHomeCreatedBy")
  deletedTestQuestionHomes      TestQuestionHome[]                    @relation("TestQuestionHomeDeletedBy")
  updatedTestQuestionHomes      TestQuestionHome[]                    @relation("TestQuestionHomeUpdatedBy")
  createdBy                     User?                                 @relation("CreatorUsers", fields: [createdById], references: [id], onUpdate: NoAction)
  createdUsers                  User[]                                @relation("CreatorUsers")
  deletedBy                     User?                                 @relation("DeletorUsers", fields: [deletedById], references: [id], onUpdate: NoAction)
  deletedUsers                  User[]                                @relation("DeletorUsers")
  figure                        Figure?                               @relation(fields: [figureId], references: [id], onUpdate: NoAction)
  godProfile                    GodProfile?                           @relation(fields: [godProfileId], references: [id], onUpdate: NoAction)
  role                          Role                                  @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updatedBy                     User?                                 @relation("UpdatorUsers", fields: [updatedById], references: [id], onUpdate: NoAction)
  updatedUsers                  User[]                                @relation("UpdatorUsers")
  createdUserAchievements       UserAchievement[]                     @relation("UserAchievementCreatedBy")
  deletedUserAchievements       UserAchievement[]                     @relation("UserAchievementDeletedBy")
  updatedUserAchievements       UserAchievement[]                     @relation("UserAchievementUpdatedBy")
  userAchievements              UserAchievement[]
  createdUserAnswerLogs         UserAnswerLog[]                       @relation("UserAnswerLogCreatedBy")
  deletedUserAnswerLogs         UserAnswerLog[]                       @relation("UserAnswerLogDeletedBy")
  updatedUserAnswerLogs         UserAnswerLog[]                       @relation("UserAnswerLogUpdatedBy")
  userAnswerLogs                UserAnswerLog[]
  createdUserLands              UserLand[]                            @relation("UserLandCreatedBy")
  deletedUserLands              UserLand[]                            @relation("UserLandDeletedBy")
  updatedUserLands              UserLand[]                            @relation("UserLandUpdatedBy")
  userLands                     UserLand[]
  createdUserLandBarges         UserLandBarge[]                       @relation("UserLandBargeCreatedBy")
  deletedUserLandBarges         UserLandBarge[]                       @relation("UserLandBargeDeletedBy")
  updatedUserLandBarges         UserLandBarge[]                       @relation("UserLandBargeUpdatedBy")
  userLandBarges                UserLandBarge[]
  createdUserRewards            UserReward[]                          @relation("UserRewardCreatedBy")
  deletedUserRewards            UserReward[]                          @relation("UserRewardDeletedBy")
  updatedUserRewards            UserReward[]                          @relation("UserRewardUpdatedBy")
  userRewards                   UserReward[]
  createdUserTestQHs            UserTestQuestionHome[]                @relation("UserTestQuestionHomeCreatedBy")
  deletedUserTestQHs            UserTestQuestionHome[]                @relation("UserTestQuestionHomeDeletedBy")
  updatedUserTestQHs            UserTestQuestionHome[]                @relation("UserTestQuestionHomeUpdatedBy")

  createdChangePointUserLogs ChangePointUserLog[] @relation("ChangePointUserLogCreatedBy")
  updatedChangePointUserLogs ChangePointUserLog[] @relation("ChangePointUserLogUpdatedBy")
  deletedChangePointUserLogs ChangePointUserLog[] @relation("ChangePointUserLogDeletedBy")

  userTestQuestionHomes UserTestQuestionHome[]
  userKyNhanSummaries   KyNhanSummary[]        @relation("KyNhanSummaryToUser")
  userKynhans           KyNhan[]               @relation("KyNhanToUser")
  changePointUserLogs   ChangePointUserLog[]

  @@index([deletedAt])
  @@index([email])
}

model Device {
  id            Int            @id @default(autoincrement())
  userId        Int
  userAgent     String
  ip            String
  lastActive    DateTime       @updatedAt
  createdAt     DateTime       @default(now())
  isActive      Boolean        @default(true)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  refreshTokens RefreshToken[]
}

model RefreshToken {
  token     String   @unique @db.VarChar(1000)
  userId    Int
  deviceId  Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expiresAt])
}

model Permission {
  id          Int        @id @default(autoincrement())
  name        String     @db.VarChar(500)
  description String     @default("")
  path        String     @db.VarChar(1000)
  method      HTTPMethod
  module      String     @default("") @db.VarChar(500)
  createdById Int?
  updatedById Int?
  deletedById Int?
  deletedAt   DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  createdBy   User?      @relation("PermissionCreatedBy", fields: [createdById], references: [id], onUpdate: NoAction)
  deletedBy   User?      @relation("PermissionDeletedBy", fields: [deletedById], references: [id], onUpdate: NoAction)
  updatedBy   User?      @relation("PermissionUpdatedBy", fields: [updatedById], references: [id], onUpdate: NoAction)
  roles       Role[]     @relation("PermissionToRole")

  @@index([deletedAt])
}

model Role {
  id          Int          @id @default(autoincrement())
  name        String       @db.VarChar(500)
  description String       @default("")
  isActive    Boolean      @default(true)
  createdById Int?
  updatedById Int?
  deletedById Int?
  deletedAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  createdBy   User?        @relation("RoleCreatedBy", fields: [createdById], references: [id], onUpdate: NoAction)
  deletedBy   User?        @relation("RoleDeletedBy", fields: [deletedById], references: [id], onUpdate: NoAction)
  updatedBy   User?        @relation("RoleUpdatedBy", fields: [updatedById], references: [id], onUpdate: NoAction)
  users       User[]
  permissions Permission[] @relation("PermissionToRole")

  @@index([deletedAt])
}

model KyNhan {
  id              Int             @id @default(autoincrement())
  name            String          @unique @db.VarChar(500)
  thoiKy          String          @db.VarChar(500)
  chienCong       String
  imgUrl          String?         @db.VarChar(1000)
  active          Boolean         @default(false)
  deletedAt       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  createdById     Int?
  deletedById     Int?
  updatedById     Int?
  landId          Int?
  chiTietKyNhans  ChiTietKyNhan[]
  createdBy       User?           @relation("KyNhanCreatedBy", fields: [createdById], references: [id], onUpdate: NoAction)
  deletedBy       User?           @relation("KyNhanDeletedBy", fields: [deletedById], references: [id], onUpdate: NoAction)
  land            Land?           @relation(fields: [landId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updatedBy       User?           @relation("KyNhanUpdatedBy", fields: [updatedById], references: [id], onUpdate: NoAction)
  kyNhanSummaries KyNhanSummary[]
  motaKyNhan      MotaKyNhan?
  users           User[]          @relation("KyNhanToUser")

  @@index([deletedAt])
}

model MotaKyNhan {
  id            Int       @id @default(autoincrement())
  ten           String    @db.VarChar(500)
  danhHieu      String?   @db.VarChar(500)
  namSinhNamMat String?   @db.VarChar(100)
  queQuan       String?   @db.VarChar(500)
  xuatThan      String?   @db.VarChar(500)
  khoiNghia     String?   @db.VarChar(500)
  nguoiDongHanh String?   @db.VarChar(500)
  phuQuan       String?   @db.VarChar(500)
  chienCong     String?   @db.VarChar(500)
  dinhCao       String?   @db.VarChar(500)
  ketCuc        String?   @db.VarChar(500)
  imgUrl        String?   @db.VarChar(1000)
  kyNhanId      Int       @unique
  createdById   Int?
  updatedById   Int?
  deletedById   Int?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdBy     User?     @relation("MoTaKyNhanCreatedBy", fields: [createdById], references: [id], onUpdate: NoAction)
  deletedBy     User?     @relation("MoTaKyNhanDeletedBy", fields: [deletedById], references: [id], onUpdate: NoAction)
  kyNhan        KyNhan    @relation(fields: [kyNhanId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  updatedBy     User?     @relation("MoTaKyNhanUpdatedBy", fields: [updatedById], references: [id], onUpdate: NoAction)

  @@index([deletedAt])
}

model ChiTietKyNhan {
  id                     Int                                   @id @default(autoincrement())
  kyNhanId               Int
  deletedAt              DateTime?
  createdAt              DateTime                              @default(now())
  updatedAt              DateTime                              @updatedAt
  createdById            Int?
  deletedById            Int?
  updatedById            Int?
  thamKhao               String?
  createdBy              User?                                 @relation("ChiTietKyNhanCreatedBy", fields: [createdById], references: [id], onUpdate: NoAction)
  deletedBy              User?                                 @relation("ChiTietKyNhanDeletedBy", fields: [deletedById], references: [id], onUpdate: NoAction)
  kyNhan                 KyNhan                                @relation(fields: [kyNhanId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  updatedBy              User?                                 @relation("ChiTietKyNhanUpdatedBy", fields: [updatedById], references: [id], onUpdate: NoAction)
  boiCanhLichSuVaSuuThan ChiTietKyNhanBoiCanhLichSuVaSuuThan[]
  giaiThoaiDanGian       ChiTietKyNhanGiaiThoaiDanGian[]
  suSachVietGi           ChiTietKyNhanSuSachVietGi[]
  media                  Media[]

  @@index([deletedAt])
}

model ChiTietKyNhanBoiCanhLichSuVaSuuThan {
  id              Int           @id @default(autoincrement())
  chiTietKyNhanId Int
  tieuDe          String        @db.VarChar(500)
  noiDung         String
  nguon           String?
  thuTu           Int           @default(0)
  createdById     Int?
  updatedById     Int?
  deletedById     Int?
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  chiTietKyNhan   ChiTietKyNhan @relation(fields: [chiTietKyNhanId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdBy       User?         @relation("ChiTietKyNhanBoiCanhLichSuVaSuuThanCreatedBy", fields: [createdById], references: [id], onUpdate: NoAction)
  deletedBy       User?         @relation("ChiTietKyNhanBoiCanhLichSuVaSuuThanDeletedBy", fields: [deletedById], references: [id], onUpdate: NoAction)
  updatedBy       User?         @relation("ChiTietKyNhanBoiCanhLichSuVaSuuThanUpdatedBy", fields: [updatedById], references: [id], onUpdate: NoAction)

  @@index([deletedAt])
  @@index([chiTietKyNhanId])
}

model ChiTietKyNhanSuSachVietGi {
  id              Int           @id @default(autoincrement())
  chiTietKyNhanId Int
  tieuDe          String        @db.VarChar(500)
  doanVan         String
  tacGia          String?       @db.VarChar(500)
  nguonSach       String?
  thuTu           Int           @default(0)
  createdById     Int?
  updatedById     Int?
  deletedById     Int?
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  chiTietKyNhan   ChiTietKyNhan @relation(fields: [chiTietKyNhanId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdBy       User?         @relation("ChiTietKyNhanSuSachVietGiCreatedBy", fields: [createdById], references: [id], onUpdate: NoAction)
  deletedBy       User?         @relation("ChiTietKyNhanSuSachVietGiDeletedBy", fields: [deletedById], references: [id], onUpdate: NoAction)
  updatedBy       User?         @relation("ChiTietKyNhanSuSachVietGiUpdatedBy", fields: [updatedById], references: [id], onUpdate: NoAction)

  @@index([deletedAt])
  @@index([chiTietKyNhanId])
}

model ChiTietKyNhanGiaiThoaiDanGian {
  id              Int           @id @default(autoincrement())
  chiTietKyNhanId Int
  tieuDe          String        @db.VarChar(500)
  noiDung         String
  nguon           String?
  thuTu           Int           @default(0)
  createdById     Int?
  updatedById     Int?
  deletedById     Int?
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  chiTietKyNhan   ChiTietKyNhan @relation(fields: [chiTietKyNhanId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdBy       User?         @relation("ChiTietKyNhanGiaiThoaiDanGianCreatedBy", fields: [createdById], references: [id], onUpdate: NoAction)
  deletedBy       User?         @relation("ChiTietKyNhanGiaiThoaiDanGianDeletedBy", fields: [deletedById], references: [id], onUpdate: NoAction)
  updatedBy       User?         @relation("ChiTietKyNhanGiaiThoaiDanGianUpdatedBy", fields: [updatedById], references: [id], onUpdate: NoAction)

  @@index([deletedAt])
  @@index([chiTietKyNhanId])
}

model KyNhanSummary {
  id          Int       @id @default(autoincrement())
  kyNhanId    Int
  summary     String?   @db.VarChar
  createdById Int?
  updatedById Int?
  deletedById Int?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  questionId  Int?
  imgUrl      String?   @db.VarChar(1000)
  createdBy   User?     @relation("KyNhanSummaryCreatedBy", fields: [createdById], references: [id], onUpdate: NoAction)
  deletedBy   User?     @relation("KyNhanSummaryDeletedBy", fields: [deletedById], references: [id], onUpdate: NoAction)
  kyNhan      KyNhan    @relation(fields: [kyNhanId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  question    Question? @relation(fields: [questionId], references: [id], onUpdate: NoAction)
  updatedBy   User?     @relation("KyNhanSummaryUpdatedBy", fields: [updatedById], references: [id], onUpdate: NoAction)
  users       User[]    @relation("KyNhanSummaryToUser")

  @@index([deletedAt])
}

model UserLand {
  id          Int            @id @default(autoincrement())
  userId      Int
  landId      Int
  status      UserLandStatus @default(LOCKED)
  createdById Int?
  updatedById Int?
  deletedById Int?
  deletedAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  createdBy   User?          @relation("UserLandCreatedBy", fields: [createdById], references: [id], onUpdate: NoAction)
  deletedBy   User?          @relation("UserLandDeletedBy", fields: [deletedById], references: [id], onUpdate: NoAction)
  land        Land           @relation(fields: [landId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  updatedBy   User?          @relation("UserLandUpdatedBy", fields: [updatedById], references: [id], onUpdate: NoAction)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model Land {
  id            Int           @id @default(autoincrement())
  name          String        @db.VarChar(500)
  order         Int           @default(0)
  createdById   Int?
  updatedById   Int?
  deletedById   Int?
  deletedAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  totalQuestion Int           @default(0)
  achievements  Achievement[]
  kyNhans       KyNhan[]
  createdBy     User?         @relation("LandCreatedBy", fields: [createdById], references: [id], onUpdate: NoAction)
  deletedBy     User?         @relation("LandDeletedBy", fields: [deletedById], references: [id], onUpdate: NoAction)
  updatedBy     User?         @relation("LandUpdatedBy", fields: [updatedById], references: [id], onUpdate: NoAction)
  landBarges    LandBarge?
  questions     Question[]
  userLands     UserLand[]
}

model LandBarge {
  id             Int             @id @default(autoincrement())
  landId         Int             @unique
  imgUrl         String?         @db.VarChar(1000)
  createdById    Int?
  updatedById    Int?
  deletedById    Int?
  deletedAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  createdBy      User?           @relation("LandBargeCreatedBy", fields: [createdById], references: [id], onUpdate: NoAction)
  deletedBy      User?           @relation("LandBargeDeletedBy", fields: [deletedById], references: [id], onUpdate: NoAction)
  land           Land            @relation(fields: [landId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  updatedBy      User?           @relation("LandBargeUpdatedBy", fields: [updatedById], references: [id], onUpdate: NoAction)
  userLandBarges UserLandBarge[]
}

model UserLandBarge {
  id          Int       @id @default(autoincrement())
  userId      Int
  landBargeId Int
  status      Boolean   @default(false)
  createdById Int?
  updatedById Int?
  deletedById Int?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   User?     @relation("UserLandBargeCreatedBy", fields: [createdById], references: [id], onUpdate: NoAction)
  deletedBy   User?     @relation("UserLandBargeDeletedBy", fields: [deletedById], references: [id], onUpdate: NoAction)
  landBarge   LandBarge @relation(fields: [landBargeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  updatedBy   User?     @relation("UserLandBargeUpdatedBy", fields: [updatedById], references: [id], onUpdate: NoAction)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model SystemConfig {
  id          Int       @id @default(autoincrement())
  launchDate  DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById Int?
  deletedAt   DateTime?
  deletedById Int?
  updatedById Int?
  isActive    Boolean   @default(true)
  createdBy   User?     @relation("SystemConfigCreatedBy", fields: [createdById], references: [id], onUpdate: NoAction)
  deletedBy   User?     @relation("SystemConfigDeletedBy", fields: [deletedById], references: [id], onUpdate: NoAction)
  updatedBy   User?     @relation("SystemConfigUpdatedBy", fields: [updatedById], references: [id], onUpdate: NoAction)
}

model Media {
  id          Int           @id @default(autoincrement())
  chiTietId   Int
  type        MediaType
  url         String        @db.VarChar(1000)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  createdById Int?
  deletedAt   DateTime?
  deletedById Int?
  fileName    String?       @db.VarChar(500)
  fileSize    Int?
  mimeType    String?       @db.VarChar(100)
  thuTu       Int           @default(0)
  updatedById Int?
  chiTiet     ChiTietKyNhan @relation(fields: [chiTietId], references: [id], onDelete: Cascade)
  createdBy   User?         @relation("MediaCreatedBy", fields: [createdById], references: [id], onUpdate: NoAction)
  deletedBy   User?         @relation("MediaDeletedBy", fields: [deletedById], references: [id], onUpdate: NoAction)
  updatedBy   User?         @relation("MediaUpdatedBy", fields: [updatedById], references: [id], onUpdate: NoAction)

  @@index([deletedAt])
  @@index([chiTietId])
}

model Attendance {
  id          Int              @id @default(autoincrement())
  date        DateTime
  status      AttendanceStatus
