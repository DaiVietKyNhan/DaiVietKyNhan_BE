generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int             @id @default(autoincrement())
  email              String          @unique @db.VarChar(500)
  name               String          @db.VarChar(500)
  password           String          @db.VarChar(500)
  phoneNumber        String          @db.VarChar(50)
  gender             Gender?
  birthDate          DateTime?
  avatar             String?         @db.VarChar(1000)
  status             UserStatus      @default(INACTIVE)
  roleId             Int
  role               Role            @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  devices            Device[] // Liên kết 1-n với Device
  refreshTokens      RefreshToken[]
  createdPermissions Permission[]    @relation("PermissionCreatedBy")
  updatedPermissions Permission[]    @relation("PermissionUpdatedBy")
  deletedPermissions Permission[]    @relation("PermissionDeletedBy")
  createdRoles       Role[]          @relation("RoleCreatedBy")
  updatedRoles       Role[]          @relation("RoleUpdatedBy")
  deletedRoles       Role[]          @relation("RoleDeletedBy")
  createdKyNhans     KyNhan[]        @relation("KyNhanCreatedBy")
  updatedKyNhans     KyNhan[]        @relation("KyNhanUpdatedBy")
  deletedKyNhans     KyNhan[]        @relation("KyNhanDeletedBy")
  createdChiTiets    ChiTietKyNhan[] @relation("ChiTietKyNhanCreatedBy")
  updatedChiTiets    ChiTietKyNhan[] @relation("ChiTietKyNhanUpdatedBy")
  deletedChiTiets    ChiTietKyNhan[] @relation("ChiTietKyNhanDeletedBy")

  // 1 user có thể tạo ra nhiều user khác
  // 1 user chỉ có thể được tạo ra bởi 1 user khác
  // Tự quan hệ 1-n
  createdById  Int?
  createdBy    User?  @relation("CreatorUsers", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  createdUsers User[] @relation("CreatorUsers")

  updatedById  Int?
  updatedBy    User?  @relation("UpdatorUsers", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  updatedUsers User[] @relation("UpdatorUsers")
  deletedById  Int?
  deletedBy    User?  @relation("DeletorUsers", fields: [deletedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  deletedUsers User[] @relation("DeletorUsers")

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([deletedAt])
  @@index(email)
}

model Device {
  id            Int            @id @default(autoincrement())
  userId        Int
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  userAgent     String
  ip            String
  lastActive    DateTime       @updatedAt // Thay updatedAt bằng lastActive cho ý nghĩa rõ hơn
  createdAt     DateTime       @default(now())
  isActive      Boolean        @default(true) // Trạng thái thiết bị (đang login hay đã logout)
  refreshTokens RefreshToken[] // Liên kết 1-n với RefreshToken
}

model RefreshToken {
  token     String   @unique @db.VarChar(1000)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  deviceId  Int // Foreign key tới Device
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model Permission {
  id          Int        @id @default(autoincrement())
  name        String     @db.VarChar(500)
  description String     @default("")
  path        String     @db.VarChar(1000)
  method      HTTPMethod
  module      String     @default("") @db.VarChar(500)
  roles       Role[]

  createdById Int?
  createdBy   User? @relation("PermissionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  updatedById Int?
  updatedBy   User? @relation("PermissionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  deletedById Int?
  deletedBy   User? @relation("PermissionDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull, onUpdate: NoAction)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([deletedAt])
}

model Role {
  id          Int          @id @default(autoincrement())
  name        String       @db.VarChar(500)
  description String       @default("")
  isActive    Boolean      @default(true)
  permissions Permission[]
  users       User[]

  createdById Int?
  createdBy   User? @relation("RoleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  updatedById Int?
  updatedBy   User? @relation("RoleUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  deletedById Int?
  deletedBy   User? @relation("RoleDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull, onUpdate: NoAction)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([deletedAt])
}

model KyNhan {
  id        Int     @id @default(autoincrement())
  name      String  @db.VarChar(500)
  thoiKy    String  @db.VarChar(500)
  chienCong String  @db.Text()
  imgUrl    String? @db.VarChar(1000)
  active    Boolean @default(false)

  chiTietKyNhans ChiTietKyNhan[] @relation("KyNhanToChiTietKyNhan")

  createdById Int?
  createdBy   User? @relation("KyNhanCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  updatedById Int?
  updatedBy   User? @relation("KyNhanUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  deletedById Int?
  deletedBy   User? @relation("KyNhanDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull, onUpdate: NoAction)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([deletedAt])
}

model ChiTietKyNhan {
  id Int @id @default(autoincrement())

  kyNhanId Int
  kyNhan   KyNhan @relation("KyNhanToChiTietKyNhan", fields: [kyNhanId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  tinhCach  String  @db.Text()
  quanHe    String? @db.Text()
  trichDoan String  @db.Text()
  media     Media[]

  createdById Int?
  createdBy   User? @relation("ChiTietKyNhanCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  updatedById Int?
  updatedBy   User? @relation("ChiTietKyNhanUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  deletedById Int?
  deletedBy   User? @relation("ChiTietKyNhanDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull, onUpdate: NoAction)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([deletedAt])
}

model SystemConfig {
  id         Int      @id @default(autoincrement())
  launchDate DateTime // Ngày trang web chính thức mở
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Media {
  id        Int           @id @default(autoincrement())
  chiTietId Int
  chiTiet   ChiTietKyNhan @relation(fields: [chiTietId], references: [id], onDelete: Cascade)
  type      MediaType
  url       String        @db.VarChar(1000)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

enum VerificationCodeType {
  REGISTER
  FORGOT_PASSWORD
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum HTTPMethod {
  GET
  POST
  PUT
  DELETE
  PATCH
  OPTIONS
  HEAD
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}
