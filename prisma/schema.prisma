generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int        @id @default(autoincrement())
  email         String     @unique @db.VarChar(500)
  name          String     @db.VarChar(500)
  password      String     @db.VarChar(500)
  phoneNumber   String?    @db.VarChar(50)
  gender        Gender?
  birthDate     DateTime?
  avatar        String?    @db.VarChar(1000)
  status        UserStatus @default(INACTIVE)
  coin          Int        @default(0)
  point         Int        @default(0)
  pointTestHome Int?

  roleId Int
  role   Role @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  devices               Device[] // Liên kết 1-n với Device
  refreshTokens         RefreshToken[]
  attendances           Attendance[]
  userTestQuestionHomes UserTestQuestionHome[]
  userAnswerLogs        UserAnswerLog[]

  createdPermissions       Permission[]           @relation("PermissionCreatedBy")
  updatedPermissions       Permission[]           @relation("PermissionUpdatedBy")
  deletedPermissions       Permission[]           @relation("PermissionDeletedBy")
  createdRoles             Role[]                 @relation("RoleCreatedBy")
  updatedRoles             Role[]                 @relation("RoleUpdatedBy")
  deletedRoles             Role[]                 @relation("RoleDeletedBy")
  createdKyNhans           KyNhan[]               @relation("KyNhanCreatedBy")
  updatedKyNhans           KyNhan[]               @relation("KyNhanUpdatedBy")
  deletedKyNhans           KyNhan[]               @relation("KyNhanDeletedBy")
  createdChiTiets          ChiTietKyNhan[]        @relation("ChiTietKyNhanCreatedBy")
  updatedChiTiets          ChiTietKyNhan[]        @relation("ChiTietKyNhanUpdatedBy")
  deletedChiTiets          ChiTietKyNhan[]        @relation("ChiTietKyNhanDeletedBy")
  createdKyNhanSummaries   KyNhanSummary[]        @relation("KyNhanSummaryCreatedBy")
  updatedKyNhanSummaries   KyNhanSummary[]        @relation("KyNhanSummaryUpdatedBy")
  deletedKyNhanSummaries   KyNhanSummary[]        @relation("KyNhanSummaryDeletedBy")
  createdSystemConfigs     SystemConfig[]         @relation("SystemConfigCreatedBy")
  updatedSystemConfigs     SystemConfig[]         @relation("SystemConfigUpdatedBy")
  deletedSystemConfigs     SystemConfig[]         @relation("SystemConfigDeletedBy")
  createdAttendances       Attendance[]           @relation("AttendanceCreatedBy")
  updatedAttendances       Attendance[]           @relation("AttendanceUpdatedBy")
  deletedAttendances       Attendance[]           @relation("AttendanceDeletedBy")
  createdAttendanceConfigs AttendanceConfig[]     @relation("AttendanceConfigCreatedBy")
  updatedAttendanceConfigs AttendanceConfig[]     @relation("AttendanceConfigUpdatedBy")
  deletedAttendanceConfigs AttendanceConfig[]     @relation("AttendanceConfigDeletedBy")
  createdQuestions         Question[]             @relation("QuestionCreatedBy")
  updatedQuestions         Question[]             @relation("QuestionUpdatedBy")
  deletedQuestions         Question[]             @relation("QuestionDeletedBy")
  createdAnswers           Answer[]               @relation("AnswerCreatedBy")
  updatedAnswers           Answer[]               @relation("AnswerUpdatedBy")
  deletedAnswers           Answer[]               @relation("AnswerDeletedBy")
  createdValidTextInputs   ValidTextInputAnswer[] @relation("ValidTextInputAnswerCreatedBy")
  updatedValidTextInputs   ValidTextInputAnswer[] @relation("ValidTextInputAnswerUpdatedBy")
  deletedValidTextInputs   ValidTextInputAnswer[] @relation("ValidTextInputAnswerDeletedBy")
  createdUserAnswerLogs    UserAnswerLog[]        @relation("UserAnswerLogCreatedBy")
  updatedUserAnswerLogs    UserAnswerLog[]        @relation("UserAnswerLogUpdatedBy")
  deletedUserAnswerLogs    UserAnswerLog[]        @relation("UserAnswerLogDeletedBy")
  createdTestQuestionHomes TestQuestionHome[]     @relation("TestQuestionHomeCreatedBy")
  updatedTestQuestionHomes TestQuestionHome[]     @relation("TestQuestionHomeUpdatedBy")
  deletedTestQuestionHomes TestQuestionHome[]     @relation("TestQuestionHomeDeletedBy")
  createdUserTestQHs       UserTestQuestionHome[] @relation("UserTestQuestionHomeCreatedBy")
  updatedUserTestQHs       UserTestQuestionHome[] @relation("UserTestQuestionHomeUpdatedBy")
  deletedUserTestQHs       UserTestQuestionHome[] @relation("UserTestQuestionHomeDeletedBy")

  // 1 user có thể tạo ra nhiều user khác
  // 1 user chỉ có thể được tạo ra bởi 1 user khác
  // Tự quan hệ 1-n

  createdById  Int?
  createdBy    User?  @relation("CreatorUsers", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  createdUsers User[] @relation("CreatorUsers")

  updatedById  Int?
  updatedBy    User?  @relation("UpdatorUsers", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  updatedUsers User[] @relation("UpdatorUsers")
  deletedById  Int?
  deletedBy    User?  @relation("DeletorUsers", fields: [deletedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  deletedUsers User[] @relation("DeletorUsers")

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([deletedAt])
  @@index(email)
}

model Device {
  id            Int            @id @default(autoincrement())
  userId        Int
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  userAgent     String
  ip            String
  lastActive    DateTime       @updatedAt // Thay updatedAt bằng lastActive cho ý nghĩa rõ hơn
  createdAt     DateTime       @default(now())
  isActive      Boolean        @default(true) // Trạng thái thiết bị (đang login hay đã logout)
  refreshTokens RefreshToken[] // Liên kết 1-n với RefreshToken
}

model RefreshToken {
  token     String   @unique @db.VarChar(1000)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  deviceId  Int // Foreign key tới Device
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model Permission {
  id          Int        @id @default(autoincrement())
  name        String     @db.VarChar(500)
  description String     @default("")
  path        String     @db.VarChar(1000)
  method      HTTPMethod
  module      String     @default("") @db.VarChar(500)
  roles       Role[]

  createdById Int?
  createdBy   User? @relation("PermissionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  updatedById Int?
  updatedBy   User? @relation("PermissionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  deletedById Int?
  deletedBy   User? @relation("PermissionDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull, onUpdate: NoAction)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([deletedAt])
}

model Role {
  id          Int          @id @default(autoincrement())
  name        String       @db.VarChar(500)
  description String       @default("")
  isActive    Boolean      @default(true)
  permissions Permission[]
  users       User[]

  createdById Int?
  createdBy   User? @relation("RoleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  updatedById Int?
  updatedBy   User? @relation("RoleUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  deletedById Int?
  deletedBy   User? @relation("RoleDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull, onUpdate: NoAction)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([deletedAt])
}

model KyNhan {
  id        Int     @id @default(autoincrement())
  name      String  @db.VarChar(500)
  thoiKy    String  @db.VarChar(500)
  chienCong String  @db.Text()
  imgUrl    String? @db.VarChar(1000)
  active    Boolean @default(false)

  chiTietKyNhans ChiTietKyNhan[] @relation("KyNhanToChiTietKyNhan")

  createdById Int?
  createdBy   User? @relation("KyNhanCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  updatedById Int?
  updatedBy   User? @relation("KyNhanUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  deletedById Int?
  deletedBy   User? @relation("KyNhanDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull, onUpdate: NoAction)

  deletedAt     DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  KyNhanSummary KyNhanSummary[]

  @@index([deletedAt])
}

model Land {
  id          Int    @id @default(autoincrement())
  name        String @db.VarChar(500)
  description String @db.VarChar(1000)
  order       Int    @unique

  @@map("lands")
}

model ChiTietKyNhan {
  id Int @id @default(autoincrement())

  kyNhanId Int
  kyNhan   KyNhan @relation("KyNhanToChiTietKyNhan", fields: [kyNhanId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  tinhCach  String  @db.Text()
  quanHe    String? @db.Text()
  trichDoan String  @db.Text()
  media     Media[]

  createdById Int?
  createdBy   User? @relation("ChiTietKyNhanCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  updatedById Int?
  updatedBy   User? @relation("ChiTietKyNhanUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  deletedById Int?
  deletedBy   User? @relation("ChiTietKyNhanDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull, onUpdate: NoAction)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([deletedAt])
}

model KyNhanSummary {
  id Int @id @default(autoincrement())

  kyNhanId Int
  kyNhan   KyNhan @relation(fields: [kyNhanId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  summary  String? @db.VarChar()
  imageUrl String? @db.VarChar(1000)

  questionId Int?
  question   Question? @relation(fields: [questionId], references: [id])

  createdById Int?
  createdBy   User? @relation("KyNhanSummaryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  updatedById Int?
  updatedBy   User? @relation("KyNhanSummaryUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  deletedById Int?
  deletedBy   User? @relation("KyNhanSummaryDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull, onUpdate: NoAction)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([deletedAt])
}

model SystemConfig {
  id          Int      @id @default(autoincrement())
  launchDate  DateTime // Ngày trang web chính thức mở
  isActive    Boolean  @default(true)
  createdById Int?
  createdBy   User?    @relation("SystemConfigCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  updatedById Int?
  updatedBy   User?    @relation("SystemConfigUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  deletedById Int?
  deletedBy   User?    @relation("SystemConfigDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull, onUpdate: NoAction)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Media {
  id        Int           @id @default(autoincrement())
  chiTietId Int
  chiTiet   ChiTietKyNhan @relation(fields: [chiTietId], references: [id], onDelete: Cascade)
  type      MediaType
  url       String        @db.VarChar(1000)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model Attendance {
  id        Int              @id @default(autoincrement())
  date      DateTime
  status    AttendanceStatus
  coin      Int              @default(0)
  bonusCoin Int              @default(0)

  userId Int
  user   User @relation(fields: [userId], references: [id])

  createdById Int?
  createdBy   User? @relation("AttendanceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  updatedById Int?
  updatedBy   User? @relation("AttendanceUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  deletedById Int?
  deletedBy   User? @relation("AttendanceDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull, onUpdate: NoAction)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, date])
}

model AttendanceConfig {
  id          Int     @id @default(autoincrement())
  dayOfWeek   WeekDay @unique // 0=CN, 1=T2, ..., 6=T7
  baseCoin    Int     @default(0) // điểm cơ bản
  bonusCoin   Int     @default(0) // coin thưởng ngày đó
  createdById Int?
  createdBy   User?   @relation("AttendanceConfigCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  updatedById Int?
  updatedBy   User?   @relation("AttendanceConfigUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  deletedById Int?
  deletedBy   User?   @relation("AttendanceConfigDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull, onUpdate: NoAction)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Question {
  id                  Int                @id @default(autoincrement())
  text                String             @db.VarChar()
  questionType        QuestionType       @default(TEXT_INPUT)
  status              QuestionStatus     @default(DRAFT)
  questionDifficulty  QuestionDifficulty @default(EASY)
  allowSimilarAnswers Boolean            @default(false)

  kynhanSummaries KyNhanSummary[]

  answers               Answer[]
  validTextInputAnswers ValidTextInputAnswer[]
  userAnswerLogs        UserAnswerLog[]

  createdById Int?
  createdBy   User? @relation("QuestionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  updatedById Int?
  updatedBy   User? @relation("QuestionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  deletedById Int?
  deletedBy   User? @relation("QuestionDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull, onUpdate: NoAction)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model TestQuestionHome {
  id                   Int                  @id @default(autoincrement())
  text                 String               @db.VarChar()
  testQuestionHomeType TestQuestionHomeType @default(NORMAL)

  answer AnswerScale

  createdById Int?
  createdBy   User? @relation("TestQuestionHomeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  updatedById Int?
  updatedBy   User? @relation("TestQuestionHomeUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  deletedById Int?
  deletedBy   User? @relation("TestQuestionHomeDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull, onUpdate: NoAction)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model UserTestQuestionHome {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  answer AnswerScale

  createdById Int?
  createdBy   User? @relation("UserTestQuestionHomeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  updatedById Int?
  updatedBy   User? @relation("UserTestQuestionHomeUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  deletedById Int?
  deletedBy   User? @relation("UserTestQuestionHomeDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull, onUpdate: NoAction)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Answer {
  id        Int     @id @default(autoincrement())
  text      String  @db.VarChar()
  isCorrect Boolean @default(false)

  questionId Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  createdById Int?
  createdBy   User? @relation("AnswerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  updatedById Int?
  updatedBy   User? @relation("AnswerUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  deletedById Int?
  deletedBy   User? @relation("AnswerDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull, onUpdate: NoAction)

  deletedAt     DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  UserAnswerLog UserAnswerLog[]
}

model ValidTextInputAnswer {
  id   Int    @id @default(autoincrement())
  text String @db.VarChar()

  questionId Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  createdById Int?
  createdBy   User? @relation("ValidTextInputAnswerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  updatedById Int?
  updatedBy   User? @relation("ValidTextInputAnswerUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  deletedById Int?
  deletedBy   User? @relation("ValidTextInputAnswerDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull, onUpdate: NoAction)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model UserAnswerLog {
  id   Int    @id @default(autoincrement())
  text String @db.VarChar()

  questionId Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  selectedAnswerId Int?
  answerChoice     Answer? @relation(fields: [selectedAnswerId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  inputTextAnswer String?

  isCorrect Boolean

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  createdById Int?
  createdBy   User? @relation("UserAnswerLogCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  updatedById Int?
  updatedBy   User? @relation("UserAnswerLogUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  deletedById Int?
  deletedBy   User? @relation("UserAnswerLogDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull, onUpdate: NoAction)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

enum VerificationCodeType {
  REGISTER
  FORGOT_PASSWORD
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum HTTPMethod {
  GET
  POST
  PUT
  DELETE
  PATCH
  OPTIONS
  HEAD
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

enum WeekDay {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum QuestionType {
  MULTIPLE_CHOICE
  TEXT_INPUT
}

enum QuestionStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

enum TestQuestionHomeType {
  NORMAL
  CONVERT
}

enum AnswerScale {
  STRONGLY_DISAGREE // Tương ứng với 0: Hoàn toàn không đồng ý
  DISAGREE // Tương ứng với 1: Không đồng ý
  NEUTRAL // Tương ứng với 2: Trung lập
  AGREE // Tương ứng với 3: Đồng ý
  STRONGLY_AGREE // Tương ứng với 4: Hoàn toàn đồng ý
}
